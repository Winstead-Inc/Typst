{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "enables the default permissions",
    "windows": ["main"],
    "permissions":
    [
        "core:default",
        "core:window:default",
        "core:window:allow-unminimize",
        "core:window:allow-show",
        "core:window:allow-set-focus",
        "core:window:allow-set-position",
        "dialog:default",
        "mcp-bridge:default"
    ]
}
